rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity 1 Validation Blueprint: UserSettings
    function isValidUserSettings(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.languageCode is string && data.languageCode.size() == 2 &&
             (data.languageCode == 'ar' || data.languageCode == 'en') &&
             data.darkTheme is bool &&
             data.eyeComfortMode is bool &&
             data.autoIsolateQuran is bool &&
             data.eqPreset is string && data.eqPreset.size() >= 1 && data.eqPreset.size() <= 30 &&
             data.eqPreset in ['FLAT', 'WARM_OUD', 'BASS_BOOST', 'VOCAL_CLEAR', 'NIGHT_COMFORT', 'CLASSICAL', 'CUSTOM'] &&
             data.eqBands is list && data.eqBands.size() == 5 &&
             data.eqBands[0] is int && data.eqBands[1] is int && data.eqBands[2] is int &&
             data.eqBands[3] is int && data.eqBands[4] is int &&
             data.bassBoostStrength is int && data.bassBoostStrength >= 0 && data.bassBoostStrength <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Entity 2 Validation Blueprint: CloudTrack
    function isValidCloudTrack(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() >= 1 && data.artist.size() <= 150 &&
             data.album is string && data.album.size() <= 150 &&
             data.genre is string && data.genre.size() <= 80 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 30 &&
             data.category in ['ARABIC_TARAB', 'CHILL_NIGHT', 'CLASSICAL', 'ENERGETIC', 'PODCAST', 'OTHER_MUSIC', 'QURAN'] &&
             data.quranAudio is bool &&
             ((data.category == 'QURAN') == data.quranAudio) &&
             data.durationMs is int && data.durationMs >= 0 && data.durationMs <= 86400000 &&
             data.sourceType is string && data.sourceType.size() >= 1 && data.sourceType.size() <= 30 &&
             data.sourceType in ['STUDIO_STARTER', 'LOCAL_URI', 'STREAM_URL', 'EXTERNAL_IMPORT'] &&
             data.sourceUri is string && data.sourceUri.size() >= 1 && data.sourceUri.size() <= 2000 &&
             data.lyrics is string && data.lyrics.size() <= 15000 &&
             data.favorite is bool &&
             data.playCount is int && data.playCount >= 0 && data.playCount <= 10000000 &&
             data.accentHex is string && data.accentHex.size() >= 4 && data.accentHex.size() <= 9 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Entity 3 Validation Blueprint: CloudPlaylist
    function isValidCloudPlaylist(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.description is string && data.description.size() <= 300 &&
             data.trackIds is list && data.trackIds.size() <= 200 &&
             (data.trackIds.size() == 0 || (data.trackIds[0] is string && data.trackIds[0].size() <= 128)) &&
             data.sourceApp is string && data.sourceApp.size() <= 100 &&
             data.quranPlaylist is bool &&
             data.coverHex is string && data.coverHex.size() >= 4 && data.coverHex.size() <= 9 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'languageCode', 'darkTheme',
                         'eyeComfortMode', 'autoIsolateQuran', 'eqPreset',
                         'eqBands', 'bassBoostStrength', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'languageCode', 'darkTheme',
                         'eyeComfortMode', 'autoIsolateQuran', 'eqPreset',
                         'eqBands', 'bassBoostStrength', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserSettings(incoming());

      allow update: if isSignedIn() &&
                       isValidUserSettings(incoming()) &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'languageCode', 'darkTheme',
                         'eyeComfortMode', 'autoIsolateQuran', 'eqPreset',
                         'eqBands', 'bassBoostStrength', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // Collection 2: /users/{userId}/tracks/{trackId}
      match /tracks/{trackId} {
        allow get: if isSignedIn() &&
                      isValidId(userId) &&
                      isValidId(trackId) &&
                      request.auth.uid == userId &&
                      existing().userId == request.auth.uid;

        allow list: if isSignedIn() &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(trackId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'artist', 'album', 'genre',
                           'category', 'quranAudio', 'durationMs', 'sourceType',
                           'sourceUri', 'lyrics', 'favorite', 'playCount',
                           'accentHex', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'artist', 'album', 'genre',
                           'category', 'quranAudio', 'durationMs', 'sourceType',
                           'sourceUri', 'lyrics', 'favorite', 'playCount',
                           'accentHex', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidCloudTrack(incoming());

        allow update: if isSignedIn() &&
                         isValidCloudTrack(incoming()) &&
                         isValidId(userId) &&
                         isValidId(trackId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'artist', 'album', 'genre', 'category',
                           'quranAudio', 'durationMs', 'sourceType', 'sourceUri',
                           'lyrics', 'favorite', 'playCount', 'accentHex', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(trackId) &&
                         request.auth.uid == userId &&
                         existing().userId == request.auth.uid;
      }

      // Collection 3: /users/{userId}/playlists/{playlistId}
      match /playlists/{playlistId} {
        allow get: if isSignedIn() &&
                      isValidId(userId) &&
                      isValidId(playlistId) &&
                      request.auth.uid == userId &&
                      existing().userId == request.auth.uid;

        allow list: if isSignedIn() &&
                       request.auth.uid == userId &&
                       existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(playlistId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'description', 'trackIds',
                           'sourceApp', 'quranPlaylist', 'coverHex',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'description', 'trackIds',
                           'sourceApp', 'quranPlaylist', 'coverHex',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidCloudPlaylist(incoming());

        allow update: if isSignedIn() &&
                         isValidCloudPlaylist(incoming()) &&
                         isValidId(userId) &&
                         isValidId(playlistId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'description', 'trackIds', 'sourceApp',
                           'quranPlaylist', 'coverHex', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(playlistId) &&
                         request.auth.uid == userId &&
                         existing().userId == request.auth.uid;
      }
    }
  }
}
